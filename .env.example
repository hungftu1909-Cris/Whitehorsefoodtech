# Copy this file to .env.local (dev) or configure these as environment
# variables in your Hostinger Node.js app settings (production).
# Never commit the real .env / .env.local file — it's already in .gitignore.

# Public site URL — used for canonical links, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://whitehorsefoodtech.com

# SMTP credentials for the Contact and RFQ forms (src/lib/mailer.ts).
# Without these set, form submissions are only logged to the server console
# instead of emailed — fine for local development, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
