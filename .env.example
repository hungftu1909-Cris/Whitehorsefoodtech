# Copy this file to .env.local (dev), or add these under Vercel → Project →
# Settings → Environment Variables (production).
# Never commit the real .env / .env.local file — it's already in .gitignore.

# Public site URL — used for canonical links, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://whitehorsefoodtech.com

# SMTP credentials for the Contact and RFQ forms (src/lib/mailer.ts).
# Without these set, form submissions are only logged to the server console
# (Vercel function logs) instead of emailed — nobody sees them in practice.
#
# whitehorsefoodtech.com's MX record points to Google Workspace, so:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=info@whitehorsefoodtech.com          (the mailbox sending the notification)
#   SMTP_PASS=<16-character Google App Password>    NOT the normal account password —
#     generate one at https://myaccount.google.com/apppasswords (requires
#     2-Step Verification enabled on that mailbox first).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Default recipient for the Contact form, and the RFQ form's fallback if
# RFQ_MAIL_TO isn't set.
MAIL_TO=
# Optional — routes quote requests (sales intent) to a different inbox than
# general contact messages, e.g. sales@whitehorsefoodtech.com. Leave unset to
# send both forms to MAIL_TO.
RFQ_MAIL_TO=
