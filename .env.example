# Copy this file to .env.local (dev), or add these under Vercel → Project →
# Settings → Environment Variables (production).
# Never commit the real .env / .env.local file — it's already in .gitignore.

# Public site URL — used for canonical links, hreflang, sitemap.xml, robots,
# JSON-LD and OG tags. Production must use the www host: the apex domain
# redirects to www, so an apex value makes every canonical point at a
# redirect. Leave unset to use the same default (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.whitehorsefoodtech.com

# How Contact/RFQ submissions are delivered (src/lib/lead-delivery.ts):
#   smtp — email via the SMTP settings below. If SMTP is not configured the
#          API returns 503 and the form tells the visitor to email us; if
#          sending fails it returns 502. It never reports success otherwise.
#   log  — write a redacted summary to the server log and return success.
#          Local development / Vercel Preview only; refused (503) in a
#          Vercel Production deployment.
# Unset: smtp in production (VERCEL_ENV=production, or NODE_ENV=production
# off Vercel), log everywhere else. Set it explicitly to test either path
# locally, e.g. LEAD_DELIVERY_MODE=log npm run start.
LEAD_DELIVERY_MODE=

# SMTP credentials for the Contact and RFQ forms (smtp mode). Scope them to
# the Vercel Production environment only, so Preview deployments fall back
# to log mode and can never email the real inbox.
#
# whitehorsefoodtech.com's MX record points to Google Workspace, so:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=info@whitehorsefoodtech.com          (the mailbox sending the notification)
#   SMTP_PASS=<16-character Google App Password>    NOT the normal account password —
#     generate one at https://myaccount.google.com/apppasswords (requires
#     2-Step Verification enabled on that mailbox first).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Default recipient for the Contact form, and the RFQ form's fallback if
# RFQ_MAIL_TO isn't set.
MAIL_TO=
# Optional — routes quote requests (sales intent) to a different inbox than
# general contact messages, e.g. sales@whitehorsefoodtech.com. Leave unset to
# send both forms to MAIL_TO.
RFQ_MAIL_TO=
